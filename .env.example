# -----------------------------------------------------------------------------
# TradeVerse local env
# -----------------------------------------------------------------------------
# Copy this file to `.env.local` and fill in the values for local dev.
# `.env.local` is gitignored; `NEXT_PUBLIC_*` vars are safe to expose.
# -----------------------------------------------------------------------------

# Supabase project URL, e.g. https://<project-ref>.supabase.co
NEXT_PUBLIC_SUPABASE_URL=

# Anon (publishable) key — safe for the browser.
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Service role key — SERVER ONLY. Never expose this to the browser.
# Used by server actions / route handlers that need to bypass RLS
# (e.g. admin operations, scheduled jobs).
SUPABASE_SERVICE_ROLE_KEY=

# Site URL used by Supabase auth redirects. In dev, http://localhost:3000.
# In prod, https://tradeverse.app (or your Vercel URL).
NEXT_PUBLIC_SITE_URL=http://localhost:3000
